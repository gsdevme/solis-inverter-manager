# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Loaded automatically for local `serve` runs via godotenv.

# --- Target ---
# mock: run the pipeline against canned data (no inverter/MQTT values required;
#       default here so a fresh `cp .env.dist .env` runs out of the box).
# live: talk to the real inverter via the sidecar and publish to MQTT.
MODE=mock

# --- Inverter / sidecar (required when MODE=live; ignored when MODE=mock) ---
# The Solis RHI-3.6K-48ES-5G is reached via its Solarman V5 datalogger over TCP.
INVERTER_IP=192.168.1.50
# Datalogger serial (secret; never logged). Required when MODE=live.
INVERTER_SERIAL=0000000000
# Datalogger TCP port (Solarman V5 default).
INVERTER_PORT=8899
# Per-call socket timeout (Go duration).
INVERTER_SOCKET_TIMEOUT=10s
# Localhost HTTP endpoint of the Python sidecar that owns the Modbus transport.
SIDECAR_URL=http://127.0.0.1:8081

# --- Polling & scheduling ---
POLL_INTERVAL=60s
# Transient-error retries per poll before it counts as failed.
POLL_MAX_RETRIES=3
# Consecutive poll failures before /readyz flips not-ready. Must be >= 1.
FAILURE_THRESHOLD=3

# Opt-in periodic RTC auto-sync, folded into the poll. Off by default so the
# flash-wear guardrail is never touched without an explicit opt-in. When true, a
# poll whose decoded clock drifts by more than RTC_DRIFT_THRESHOLD runs the guarded
# 43000-43005 write.
RTC_SYNC_ENABLED=false
# Drift above which RTC auto-sync writes (Go duration). Must be > 0.
RTC_DRIFT_THRESHOLD=60s

# --- Controls ---
# Kill switch: when false, no command entities are discovered, no command
# subscription, no reconcile — fully read-only.
CONTROLS_ENABLED=true
# Time-of-use charge window asserted into timed slots 1-2, HH:MM-HH:MM local
# time. Crossing midnight is allowed and is the normal case. Empty disables
# ToU assertion (slots 1-2 are left untouched).
TOU_WINDOW=23:30-05:30

# --- MQTT / Home Assistant (required when MODE=live; ignored when MODE=mock) ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
# MQTT password (secret; never logged).
MQTT_PASSWORD=
MQTT_CLIENT_ID=solis-inverter-manager
MQTT_TOPIC_PREFIX=solis
HA_DISCOVERY_PREFIX=homeassistant
# Entity-id prefix. Home Assistant derives every entity_id from it as
# <component>.<prefix>_<key>, e.g. sensor.solis_inverter_battery_soc. It does not
# affect unique_id or the discovery topic, which stay scoped to the datalogger
# serial, so changing it renames entity ids without orphaning registry entries.
# Must be a non-empty slug: lowercase letters, digits and underscores only.
HA_OBJECT_ID_PREFIX=solis_inverter

# --- Health & logging ---
HEALTH_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
